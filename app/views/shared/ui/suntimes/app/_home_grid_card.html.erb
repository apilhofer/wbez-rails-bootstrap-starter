<% story = local_assigns.fetch(:story) %>
<% story_href = local_assigns.fetch(:story_href) %>

<article class="cst-home-grid-card">
  <%= link_to story_href, class: "cst-home-grid-card__link text-decoration-none" do %>
    <div class="cst-home-grid-card__media" style="background: <%= story[:artwork_bg] %>;" aria-hidden="true"></div>
    <div class="cst-home-grid-card__body">
      <h3 class="cst-home-grid-card__title"><%= story[:title] %></h3>
      <time class="cst-home-grid-card__date" datetime="<%= story[:date] %>"><%= story[:date] %></time>
    </div>
  <% end %>
  <div class="cst-home-grid-card__actions">
    <%= render "shared/ui/suntimes/app/home_story_actions", story: story, story_href: story_href %>
  </div>
</article>
