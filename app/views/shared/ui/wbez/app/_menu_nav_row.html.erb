<% item = local_assigns.fetch(:item) %>
<% link_attrs = { class: "wbez-menu-nav-row text-decoration-none" } %>
<% link_attrs[:target] = "_blank" if item[:external] %>
<% link_attrs[:rel] = "noopener" if item[:external] %>

<%= link_to item[:href], **link_attrs do %>
  <span class="wbez-menu-nav-row__icon" aria-hidden="true">
    <% case item[:icon] %>
    <% when "globe" %>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/><path d="M3 12h18M12 3c2.5 2.8 3.8 6 3.8 9s-1.3 6.2-3.8 9M12 3c-2.5 2.8-3.8 6-3.8 9s1.3 6.2 3.8 9" stroke="currentColor" stroke-width="1.75"/></svg>
    <% when "donate" %>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M8.5 14.5c1.2 1.4 2.4 2 3.5 2s2.3-.6 3.5-2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><path d="M9 8.5c0-1.4 1.3-2.5 3-2.5s3 1.1 3 2.5c0 2.2-3 4.5-3 4.5S9 10.7 9 8.5Z" stroke="currentColor" stroke-width="1.75"/><path d="M7 20c-2.8-2-4.5-4.4-4.5-7.2a5.5 5.5 0 0 1 11 0c0 2.8-1.7 5.2-4.5 7.2" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
    <% when "envelope" %>
      <%= ferris_icon "envelope", classes: "wbez-menu-nav-row__ferris-icon", size: 22 %>
    <% when "calendar" %>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 3v4M16 3v4M4 10h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
    <% when "contact" %>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M7 8.5a4.5 4.5 0 0 1 9 0v.6c0 1-.4 1.9-1 2.6L12 15l-3-3.3a4 4 0 0 1-1-2.6v-.6Z" stroke="currentColor" stroke-width="1.75"/><path d="M5.5 14.5 4 19l4.5-1.2M18.5 14.5 20 19l-4.5-1.2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/><path d="M15.5 7.5a2.2 2.2 0 0 1 3.8 1.5v.4c0 .5-.2 1-.5 1.3l-1.8 1.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M8.5 7.5A2.2 2.2 0 0 0 4.7 9v.4c0 .5.2 1 .5 1.3l1.8 1.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    <% end %>
  </span>
  <span class="wbez-menu-nav-row__label"><%= item[:label] %></span>
<% end %>
