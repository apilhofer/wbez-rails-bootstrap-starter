<% show = local_assigns.fetch(:show) %>
<div class="app-mini-player app-mini-player--wbez-listen" data-controller="app-audio">
  <div class="app-mini-player__live" aria-hidden="true">
    <span class="wbez-listen-live-badge wbez-listen-live-badge--square">LIVE</span>
  </div>

  <div class="app-mini-player__meta min-w-0 flex-grow-1">
    <div class="app-mini-player__title text-truncate" data-app-audio-target="title"><%= show[:title] %></div>
    <div class="app-mini-player__subtitle text-truncate" data-app-audio-target="subtitle"><%= show[:time_range] %></div>
  </div>

  <div class="app-mini-player__controls">
    <button type="button" class="app-mini-player__skip" aria-label="Skip back 10 seconds">
      <%= ferris_icon "skip-back", classes: "app-mini-player__skip-icon", size: 22 %>
    </button>
    <button type="button" class="app-mini-player__play" data-action="app-audio#toggle" aria-label="Play or pause">
      <%= ferris_icon "play", classes: "app-mini-player__play-icon", size: 18 %>
    </button>
    <button type="button" class="app-mini-player__skip" aria-label="Skip forward 10 seconds">
      <%= ferris_icon "skip-forward", classes: "app-mini-player__skip-icon", size: 22 %>
    </button>
  </div>
</div>
