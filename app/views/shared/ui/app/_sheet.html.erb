<div class="app-sheet" data-controller="app-sheet" data-app-sheet-open-value="false">
  <div class="app-sheet__backdrop" data-action="click->app-sheet#close"></div>
  <div class="app-sheet__panel" role="dialog" aria-modal="true" aria-label="<%= local_assigns.fetch(:title, "Panel") %>">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h2 class="h6 mb-0"><%= local_assigns.fetch(:title, "Panel") %></h2>
      <button type="button" class="btn btn-sm btn-link" data-action="app-sheet#close">Close</button>
    </div>
    <%= yield %>
  </div>
</div>
