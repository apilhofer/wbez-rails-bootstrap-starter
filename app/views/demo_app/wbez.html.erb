<% content_for :title, "WBEZ App Lab" %>
<% content_for :app_experiment_banner do %>
  Experiment: <%= available_experiments.find { |e| e[:id] == current_experiment }&.dig(:label) || current_experiment %>
<% end %>
<% content_for :app_header do %>
  <%= render "shared/ui/wbez/app/app_header", title: "WBEZ", experiments_href: demo_app_wbez_experiments_path %>
<% end %>
<% content_for :app_tabbar do %>
  <%= render "shared/ui/wbez/app/bottom_tab_bar", tabs: @app_tabs, active_tab: @active_tab %>
<% end %>

<%= render_experiment_partial "river", stories: @app_stories, story_path_helper: :demo_app_wbez_story_path %>
